{
  "manifest_version": 3,
  "id": "dev-neige-binance",
  "version": "0.1.0",
  "min_kernel_version": "0.0.1",
  "display_name": "Binance Portfolio",
  "entrypoint": {
    "command": "bin/binance"
  },
  "exposes_tools": [
    {
      "name": "binance.price",
      "description": "Spot price of one symbol, read live from the Binance market-data endpoint",
      "input_schema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Trading pair, e.g. BTCUSDT"
          }
        },
        "required": ["symbol"]
      },
      "annotations": {
        "title": "Spot Price",
        "readOnlyHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "binance.portfolio.refresh",
      "description": "Re-price the configured holdings now and push the result to the configured track",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "title": "Refresh Portfolio",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
    }
  ],
  "permissions": {
    "overlays_write": ["track"],
    "kv_quota_bytes": 65536
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "track_id": {
        "type": "string",
        "description": "Track the portfolio overlays are pushed to"
      },
      "holdings": {
        "type": "string",
        "default": "BTC:100",
        "description": "Comma-separated ASSET:QUANTITY pairs, e.g. \"BTC:100,ETH:2.5\""
      },
      "quote": {
        "type": "string",
        "default": "USDT",
        "description": "Quote asset every holding is priced in"
      },
      "poll_seconds": {
        "type": "integer",
        "default": 30,
        "description": "Seconds between price refreshes (minimum 5)"
      },
      "endpoint": {
        "type": "string",
        "default": "https://data-api.binance.vision",
        "description": "Binance market-data base URL. api.binance.com is geo-restricted from some hosts; data-api.binance.vision serves the same /api/v3 paths with no key."
      }
    },
    "required": ["track_id"],
    "additionalProperties": false
  }
}
