#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$ROOT/.venv/bin/python" ]; then
    printf '%s\n' 'Barra: run python3 -m venv .venv and .venv/bin/pip install -r requirements.txt in the plugin directory first.' >&2
    exit 1
fi
exec "$ROOT/.venv/bin/python" "$ROOT/main.py"
