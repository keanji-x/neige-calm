#!/usr/bin/env python3
# A fake interactive `claude` for the #1755 trust-dialog tests, painting the screens of Claude Code
# 2.1.280 as its PTY output lays them out (rows taken from a real run):
# - the workspace trust dialog: "Accessing workspace:", the question, both options with the `❯`
#   cursor, the "Enter to confirm" footer, and no session banner. Like the real CLI it paints the
#   dialog before its input handler is live: for STARTUP seconds after the first paint a key only
#   moves the painted cursor, Enter acts on the real selection ("No, exit"), and the dialog then
#   repaints with the selection reset to No;
# - the session: the "Claude Code v2.1.280" banner on top, then the whole prompt echoed
#   (`❯ Goal: ...`, every line, so a long goal scrolls the banner off the viewport) in one write;
#   about 0.15 s later the session transcript `<transcript_dir>/<--session-id>.jsonl` is written,
#   as the real CLI does once trusted. The test names the directory the real CLI would use in a
#   `transcript_dir` file (no transcript without it): the fixture never derives it.
# It logs every byte it reads. The test copies it into a private directory next to a `scenario`
# file:
#   in:  scenario: `dialog` (Down moves the cursor; Enter on Yes starts the session), `stuck` (the
#        cursor never moves), `eatdown` (the first Down after startup is dropped), `gated`
#        (`dialog`, painted only once a `go` file exists), `takeover` (`dialog`, the cursor moves
#        on Down only once a `move` file exists), `takeenter` (`dialog` whose Enter is ignored:
#        the dialog stays), `session` (a trusted start: runs the SessionStart hook from
#        `--settings`, then paints the session and stays static), `hookloss` (`session` with no
#        hook delivered), `replica` (`hookloss`, then the screen and its scrollback cleared and
#        an exact dialog replica painted: only the transcript tells it from the dialog)
#   out: painted (a dialog or session screen is up), downed (a Down reached the live dialog),
#        entered (an Enter reached the live dialog), hooked (the SessionStart hook ran),
#        received (every byte read, appended), accepted / declined (Enter on Yes / on No)
import json
import os
import select
import subprocess
import sys
import time
import tty

D = os.path.dirname(os.path.abspath(__file__))
SCENARIO = open(os.path.join(D, "scenario")).read().strip()
OPTIONS = ["No, exit", "Yes, I trust this folder"]
STARTUP = 0.5


def write(text):
    os.write(1, text.replace("\n", "\r\n").encode())


def record(name, data=b""):
    with open(os.path.join(D, name), "ab") as out:
        out.write(data)


def paint(cursor):
    rows = ["─" * 80, " Accessing workspace:", "", " " + os.getcwd()[:78], "",
            " Quick safety check: Is this a project you created or one you trust? (Like your",
            " own code, a well-known open source project, or work from your team). If not,",
            " take a moment to review what's in this folder first.", "",
            " Claude Code'll be able to read, edit, and execute files here.", "",
            " Security guide", ""]
    rows += [(" ❯ " if at == cursor else "   ") + label for at, label in enumerate(OPTIONS)]
    rows += ["", " Enter to confirm · Esc to cancel"]
    write("\x1b[2J\x1b[H" + "\n".join(rows) + "\n")
    record("painted")


def session():
    """The session's first frame (the banner, then the whole prompt echoed) in one write, then
    its transcript."""
    prompt = sys.argv[-1].splitlines() if "--" in sys.argv else []
    rows = [" ▐▛███▛█   Claude Code v2.1.280",
            "▝▜██████▀  Opus 5.5 (1M context) · API Usage Billing",
            "  ▝▝ ▝▝    /…/" + os.path.basename(os.getcwd()), "", ""]
    rows += [("❯ " if at == 0 else "  ") + line for at, line in enumerate(prompt)]
    rows += ["", "─" * 80, "❯ ", "─" * 80]
    write("\x1b[2J\x1b[H" + "\n".join(rows) + "\n")
    record("painted")
    time.sleep(0.15)
    named = os.path.join(D, "transcript_dir")
    if os.path.exists(named):
        transcript = os.path.join(open(named).read().strip(), arg("--session-id") + ".jsonl")
        os.makedirs(os.path.dirname(transcript), exist_ok=True)
        with open(transcript, "a") as out:
            out.write('{"type":"summary"}\n')


def arg(flag):
    return sys.argv[sys.argv.index(flag) + 1] if flag in sys.argv else None


def session_start_hook():
    settings = json.load(open(arg("--settings")))
    command = settings["hooks"]["SessionStart"][0]["hooks"][0]["command"]
    body = {"hook_event_name": "SessionStart", "session_id": arg("--session-id"),
            "source": "startup", "cwd": os.getcwd()}
    done = subprocess.run(["/bin/sh", "-c", command], input=json.dumps(body).encode(),
                          stdout=subprocess.DEVNULL)
    record("hooked", str(done.returncode).encode())


def idle():
    while True:
        data = os.read(0, 64)
        if not data:
            sys.exit(0)
        record("received", data)


tty.setraw(0)
if SCENARIO in ("session", "hookloss", "replica"):
    if SCENARIO == "session":
        session_start_hook()
    session()
    if SCENARIO == "replica":
        time.sleep(0.3)
        write("\x1b[2J\x1b[3J\x1b[H")
        paint(0)
    idle()
while SCENARIO == "gated" and not os.path.exists(os.path.join(D, "go")):
    time.sleep(0.02)
cursor = 0
painted_at = time.monotonic()
paint(cursor)
remounted = False
downs = 0
pending = b""
while True:
    starting = time.monotonic() - painted_at < STARTUP
    if not starting and not remounted:
        # The dialog settles: whatever a key did to the painted cursor is undone.
        remounted = True
        cursor = 0
        paint(cursor)
    if not select.select([0], [], [], 0.05)[0]:
        continue
    data = os.read(0, 64)
    if not data:
        sys.exit(0)
    record("received", data)
    pending += data
    while pending:
        if pending.startswith((b"\x1b[B", b"\x1bOB")):
            pending = pending[3:]
            if starting:
                paint(min(cursor + 1, len(OPTIONS) - 1))
                continue
            downs += 1
            record("downed")
            if SCENARIO == "stuck" or (SCENARIO == "eatdown" and downs == 1):
                continue
            while SCENARIO == "takeover" and not os.path.exists(os.path.join(D, "move")):
                time.sleep(0.02)
            cursor = min(cursor + 1, len(OPTIONS) - 1)
            paint(cursor)
        elif pending.startswith(b"\r"):
            pending = b""
            if SCENARIO == "takeenter" and not starting:
                record("entered")
                continue
            if cursor == 1 and not starting:
                record("accepted")
                session()
                idle()
            record("declined")
            sys.exit(1)
        elif pending.startswith(b"\x1b") and len(pending) < 3:
            break
        else:
            pending = pending[1:]
