  {
    "name": "calm.plan.upsert",
    "description_sha256": "77a57bd78bfa9b58d9d719bc61156e785a8ec85d38ba0361ed7522a52d0474cc",
    "input_schema": {
      "properties": {
        "message": {
          "description": "Required human-readable rationale for this write. The kernel persists it on the emitted event as agent_message.",
          "minLength": 1,
          "type": "string"
        },
        "tasks": {
          "items": {
            "additionalProperties": false,
            "oneOf": [
              {
                "not": {
                  "required": [
                    "command"
                  ]
                },
                "properties": {
                  "kind": {
                    "enum": [
                      "codex",
                      "claude"
                    ]
                  }
                },
                "required": [
                  "key",
                  "kind",
                  "goal"
                ]
              },
              {
                "not": {
                  "required": [
                    "goal"
                  ]
                },
                "properties": {
                  "kind": {
                    "const": "terminal"
                  }
                },
                "required": [
                  "key",
                  "kind",
                  "command"
                ]
              }
            ],
            "properties": {
              "acceptance_criteria": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "command": {
                "description": "Exact Shell command passed verbatim as `/bin/sh -c <command>`; required only for terminal tasks and forbidden for codex/claude tasks.",
                "minLength": 1,
                "type": "string"
              },
              "context": {
                "description": "Optional, any JSON; forwarded to the worker verbatim."
              },
              "cwd": {
                "description": "Absolute path; terminal worker cwd + gate default cwd.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "depends_on": {
                "description": "Sibling task keys that must be done first.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "gate": {
                "description": "Verification the kernel runs after the worker reports done; declare one for every agent task. Steps run in order, first non-zero exit fails the gate, and steps must be re-runnable (kernel restarts re-run the gate).",
                "properties": {
                  "cwd": {
                    "description": "Absolute path; defaults to task.cwd, else the track cwd.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "steps": {
                    "items": {
                      "properties": {
                        "cmd": {
                          "description": "Shell command; must be re-runnable. Non-zero exit fails the gate.",
                          "minLength": 1,
                          "type": "string"
                        },
                        "name": {
                          "description": "Step label; the failing step is attributed in the gate result.",
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "cmd"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "timeout_secs": {
                    "description": "Whole-gate timeout in seconds; default 1800, max 7200. Timeout fails the gate.",
                    "maximum": 7200,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "steps"
                ],
                "type": "object"
              },
              "goal": {
                "description": "Natural-language objective; required only for codex/claude tasks and forbidden for terminal tasks.",
                "minLength": 1,
                "type": "string"
              },
              "key": {
                "description": "Stable per-track task key; also the completion correlation id.",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "codex",
                  "claude",
                  "terminal"
                ],
                "type": "string"
              },
              "no_gate_reason": {
                "description": "Escape hatch: justifies an ungated agent task on a track with `require_task_gates`; recorded into context for audit. Must be a non-empty reason (whitespace-only is rejected).",
                "minLength": 1,
                "type": "string"
              },
              "priority": {
                "description": "Higher schedules first; default 0.",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "tasks",
        "message"
      ],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "visible_to_roles": []
  },
