classDiagram
  direction LR
  class Input {
    <<host logical input>>
    proven_message_id
    origin
  }
  class QueuedInputEvidence {
    <<host frozen content evidence>>
    submitted_content
    identity Known or LegacyUnknown
    address Versioned or LegacyUnversioned
  }
  class QueueEntryRevision {
    <<host revision reference>>
    QueueEntryId / rev
    content_at_revision
    input_refs
  }
  class DispatchAttempt {
    <<host delivery attempt>>
    request_id
    submitted_payload
    evidence
  }
  class Turn {
    <<execution unit>>
    correlation_id
    native_target_when_known
  }
  QueuedInputEvidence "0..*" -- "0..*" Input : 仅关联已证实的身份
  QueuedInputEvidence "0..*" -- "0..1" QueueEntryRevision : 仅 Versioned 分支具备
  DispatchAttempt "0..*" -- "1..*" QueuedInputEvidence : 固定内容与现有身份版本证据
  DispatchAttempt "0..*" -- "0..1" Turn : 确认关联后绑定轮次
