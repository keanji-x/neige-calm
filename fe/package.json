{
  "name": "neige-calm-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev": "vite web",
    "build": "tsc -b && vite build web",
    "typecheck": "tsc -b",
    "test": "vitest run && npm run test:wire",
    "test:wire": "diff -w ../web/src/api/generated-events.ts core/api/generated/wire.ts",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:depcruise",
    "lint:js": "eslint . --ignore-pattern 'core/api/generated/**' && node tools/architecture/check-eslint-hygiene.mjs",
    "lint:css": "stylelint 'web/src/**/*.css' --allow-empty-input",
    "lint:depcruise": "depcruise core web/src --config .dependency-cruiser.cjs && node tools/architecture/check-top-level.mjs . && node tools/architecture/check-core-no-jsx.mjs core",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.3",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.4",
    "vitest": "^4.1.6"
  }
}
