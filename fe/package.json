{
  "name": "neige-calm-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run --project platform-independent --project web-dom",
    "gen:api": "cargo test --quiet --manifest-path ../Cargo.toml -p calm-types export_bindings_ && cargo run --quiet --manifest-path ../Cargo.toml --bin emit-openapi > core/api/generated/openapi.json",
    "test:browser": "vitest run --project browser --project browser-coarse",
    "test:mutation": "npm run test:mutation:fixtures && node tools/mutation/run.mjs",
    "test:mutation:fixtures": "node tools/mutation/fixture-e2e.mjs && node tools/mutation/plan-purity.mjs",
    "test:mutation:plan": "node tools/mutation/run.mjs --plan",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:depcruise",
    "lint:js": "eslint . --max-warnings=0 && node tools/architecture/check-eslint-hygiene.mjs && node tools/architecture/check-tracked-fixtures.mjs && node tools/architecture/check-breakpoint-literals.mjs && node tools/ownership/check-readonly-change-requests.mjs && node tools/test-tier/check-test-tier.mjs",
    "lint:css": "stylelint 'web/**/*.css' '!web/dist/**' && node tools/styles/check-contrast.mjs",
    "lint:depcruise": "depcruise core web/src --config .dependency-cruiser.cjs && node tools/architecture/check-top-level.mjs . && node tools/architecture/check-core-no-jsx.mjs core && node tools/architecture/directory-picker-hosts.mjs web/src",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.4",
    "@uiw/codemirror-extensions-langs": "^4.25.11",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.4",
    "react-resizable": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.4",
    "vitest": "^4.1.6",
    "yaml": "^2.9.0"
  }
}
