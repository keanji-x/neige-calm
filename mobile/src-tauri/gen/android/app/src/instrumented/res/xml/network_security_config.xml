<?xml version="1.0" encoding="utf-8"?>
<!-- Test variant only. No test CA is included in debug/release application builds. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="@raw/neige_instrumentation_ca" />
    </trust-anchors>
  </base-config>
  <!-- Emulator-host fixture control only; absent from debug/release variants. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
