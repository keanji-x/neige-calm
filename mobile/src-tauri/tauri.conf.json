{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Neige Calm",
  "version": "0.2.0",
  "identifier": "io.neigecalm.next",
  "build": {
    "beforeBuildCommand": "node scripts/build-bundled-frontend.mjs",
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Neige Calm",
        "width": 390,
        "height": 844,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "launcher-camera",
        "launcher-bundled-frontend"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
