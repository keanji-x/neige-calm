{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher-camera",
  "description": "The packaged launcher can request the camera and scan a pairing QR. Remote pages receive no native permissions.",
  "local": true,
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "barcode-scanner:allow-request-permissions",
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel"
  ]
}
