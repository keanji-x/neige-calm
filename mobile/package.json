    "test:browser": "playwright test",
    "test:pairing": "node tests/closed-loop.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tauri-apps/cli": "^2.0.0",
    "jsqr": "1.4.0"
  }
}
